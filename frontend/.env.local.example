# Copy this file to .env.local (gitignored, safe to leave there) to point
# the frontend at your local backend (npm run start:dev in api/) instead of
# the deployed App Runner API. Delete .env.local, or comment the line out,
# to switch back to the deployed backend.
#
# Requires the local backend to actually be running - see local-dev.bat in
# the repo root, which starts both the backend and frontend together.

NEXT_PUBLIC_API_URL=http://localhost:3000/api
